<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlavorFusion.Categories"
             Title="Categories">
    <VerticalStackLayout Padding="20" Spacing="20">
        <!-- Buton pentru adăugare categorie -->
        <Button Text="Create New Category"
                BackgroundColor="#91CCCA"
                TextColor="White"
                CornerRadius="10"
                HorizontalOptions="Start"
                Command="{Binding NavigateToCreateCategoryCommand}" />

        <!-- Antet pentru lista de categorii -->
        <Grid ColumnDefinitions="2*, Auto, Auto" RowSpacing="10">
            <Label Text="Category Name"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalOptions="Start"
                   VerticalOptions="Center" />

            <!-- <Label Text="Actions"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   Grid.ColumnSpan="2" /> -->
        </Grid>

        <!-- Lista categoriilor -->
        <CollectionView ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="8" BorderColor="LightGray" Padding="10" Margin="5">
                        <Grid ColumnDefinitions="2*, Auto, Auto"
                              VerticalOptions="Center"
                              RowSpacing="5"
                              Padding="10">
                            <!-- Numele categoriei -->
                            <Label Text="{Binding Name}" 
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start" />

                            <!-- Butonul Edit 
                            <Button Text="Edit"
                                    BackgroundColor="#D3D3D3"
                                    TextColor="Black"
                                    Padding="5"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCategoryCommand}"
                                    CommandParameter="{Binding}" 
                                    Grid.Column="1"
                                    Margin="5,0" /> -->

                            <!-- Butonul Delete -->
                            <Button Text="Delete"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    Padding="5"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCategoryCommand}"
                                    CommandParameter="{Binding}" 
                                    Grid.Column="2"
                                    Margin="5,0" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>