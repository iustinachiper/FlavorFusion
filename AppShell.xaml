<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FlavorFusion.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:FlavorFusion"
      Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#91CCCA"
    Shell.TabBarTitleColor="#91CCCA"
    Shell.TabBarUnselectedColor="Gray">
    <TabBar>
        <ShellContent
 Title="Recipes"
 ContentTemplate="{DataTemplate local:Recipes}"
 Route="Recipes"
 />
        <ShellContent
Title="Categories"
ContentTemplate="{DataTemplate local:Categories}"
Route="Categories"
/>
<ShellContent
Title="Users"
ContentTemplate="{DataTemplate local:Users}"
Route="Users"
/>
    </TabBar>

    <!-- Route pentru pagina Create -->
    <ShellContent Title="Create"
                  ContentTemplate="{DataTemplate local:Create}" 
                  Route="Create"
                  FlyoutItemIsVisible="False"/>

    <!-- Definește ruta pentru pagina CreateCategory -->
    <ShellContent Title="Create Category"
                  ContentTemplate="{DataTemplate local:CreateCategory}"
                  Route="CreateCategory"
                  FlyoutItemIsVisible="False"/>

    <ShellContent Title="Create New User"
              ContentTemplate="{DataTemplate local:CreateUser}"
              Route="CreateUser"
              FlyoutItemIsVisible="False"/>

</Shell>
