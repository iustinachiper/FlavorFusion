<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlavorFusion.Users"
             Title="Users">
    <VerticalStackLayout Padding="20" Spacing="10">
        <!-- Buton pentru adăugare utilizator -->
        <Button Text="Create New User"
                BackgroundColor="#91CCCA"
                TextColor="White"
                CornerRadius="10"
                HorizontalOptions="Start"
                Command="{Binding NavigateToCreateUserCommand}" />

        <!-- Titlu pentru coloanele tabelului -->
        <Grid ColumnDefinitions="2*, Auto" RowSpacing="5">
            <Label Text="Username"
                   FontAttributes="Bold"
                   FontSize="16"
                   VerticalOptions="Center" />
           <!-- <Label Text="Actions"
                   FontAttributes="Bold"
                   FontSize="16"
                   HorizontalOptions="End" />-->
        </Grid>

        <!-- Listarea utilizatorilor -->
        <CollectionView ItemsSource="{Binding Users}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame CornerRadius="8" BorderColor="LightGray" Padding="10" Margin="5">
                        <Grid ColumnDefinitions="2*, Auto, Auto"
                              VerticalOptions="Center"
                              RowSpacing="5"
                              Padding="10">
                            <!-- Numele utilizatorului -->
                            <Label Text="{Binding Username}" 
                                   FontSize="16"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start" />

                            <!-- Buton Edit
                            <Button Text="Edit"
                                    BackgroundColor="#D3D3D3"
                                    TextColor="Black"
                                    Padding="5"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditUserCommand}"
                                    CommandParameter="{Binding}" 
                                    Grid.Column="1"
                                    Margin="5,0" />  -->

                            <!-- Buton Delete -->
                            <Button Text="Delete"
                                    BackgroundColor="Red"
                                    TextColor="White"
                                    Padding="5"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteUserCommand}"
                                    CommandParameter="{Binding}" 
                                    Grid.Column="2"
                                    Margin="5,0" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
