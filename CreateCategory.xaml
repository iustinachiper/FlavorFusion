<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlavorFusion.CreateCategory"
             Title="Create Category">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Create a New Category"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Legăm conținutul Entry la proprietatea CategoryName -->
        <Entry Placeholder="Category Name"
               Text="{Binding CategoryName}" />

        <!-- Legăm butonul la comanda SaveCategoryCommand -->
        <Button Text="Save Category"
                BackgroundColor="#91CCCA"
                TextColor="White"
                Clicked="SaveCategory_Clicked" />

        <Button Text="Back to Categories"
        BackgroundColor="LightGray"
        TextColor="Black"
        Clicked="BackToCategories_Clicked" />


    </VerticalStackLayout>
</ContentPage>