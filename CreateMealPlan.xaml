<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlavorFusion.CreateMealPlan"
             Title="Create Meal Plan">
    <VerticalStackLayout Padding="20" Spacing="10">
        <Label Text="Create a New Meal Plan"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Binding către ViewModel pentru MealPlanName -->
        <Entry Placeholder="Meal Plan Name"
               Text="{Binding MealPlanName}" />

        <!-- Binding către ViewModel pentru Description -->
        <Editor Placeholder="Description"
                Text="{Binding Description}"
                AutoSize="TextChanges" />

        <Button Text="Save Meal Plan"
                BackgroundColor="Green"
                TextColor="White"
                Command="{Binding SaveMealPlanCommand}" />

        <Button Text="Back to Meal Plans"
                BackgroundColor="LightGray"
                TextColor="Black"
                Clicked="BackToMealPlans_Clicked" />


    </VerticalStackLayout>
</ContentPage>
